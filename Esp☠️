env.AmerLiteUnload = function()
	running = false
	pcall(function() RunService:UnbindFromRenderStep("AmerESP") end)
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	clearAll()
	pcall(function() gui:Destroy() end)
	env.AmerLiteUnload = nil
end
