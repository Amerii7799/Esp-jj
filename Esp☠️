-- ===== CORNER BOX =====
local function makeCornerBox(parent)
	local parts = {}
	for i = 1, 8 do
		local f = Instance.new("Frame")
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BorderSizePixel = 0
		f.Parent = parent
		parts[i] = f
	end
	return parts
end

local function updateCornerBox(parts, x, y, w, h, col, thick)
	thick = thick or 2
	local cw = math.max(w * CORNER_LEN, 6)
	local ch = math.max(h * CORNER_LEN, 6)
	parts[1].Position = UDim2.fromOffset(x, y)
	parts[1].Size = UDim2.fromOffset(cw, thick)
	parts[2].Position = UDim2.fromOffset(x, y)
	parts[2].Size = UDim2.fromOffset(thick, ch)
	parts[3].Position = UDim2.fromOffset(x + w - cw, y)
	parts[3].Size = UDim2.fromOffset(cw, thick)
	parts[4].Position = UDim2.fromOffset(x + w - thick, y)
	parts[4].Size = UDim2.fromOffset(thick, ch)
	parts[5].Position = UDim2.fromOffset(x, y + h - thick)
	parts[5].Size = UDim2.fromOffset(cw, thick)
	parts[6].Position = UDim2.fromOffset(x, y + h - ch)
	parts[6].Size = UDim2.fromOffset(thick, ch)
	parts[7].Position = UDim2.fromOffset(x + w - cw, y + h - thick)
	parts[7].Size = UDim2.fromOffset(cw, thick)
	parts[8].Position = UDim2.fromOffset(x + w - thick, y + h - ch)
	parts[8].Size = UDim2.fromOffset(thick, ch)
	for i = 1, 8 do parts[i].BackgroundColor3 = col end
end

local function hideCornerBox(parts)
	for i = 1, 8 do parts[i].Visible = false end
end

local function showCornerBox(parts)
	for i = 1, 8 do parts[i].Visible = true end
end

-- ===== TRACER =====
local function updateTracer(tracer, tx, ty, col)
	local cam = Workspace.CurrentCamera
	local vs = cam.ViewportSize
	local from = Vector2.new(vs.X / 2, vs.Y)
	local to = Vector2.new(tx, ty)
	local dir = to - from
	local len = dir.Magnitude
	tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
	tracer.Size = UDim2.fromOffset(1.5, len)
	tracer.Rotation = math.deg(math.atan2(dir.Y, dir.X)) - 90
	tracer.BackgroundColor3 = col
	tracer.Visible = true
end

-- ===== RAYCAST =====
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(cam, pos, model)
	local myChar = me.Character
	rayParams.FilterDescendantsInstances = myChar and { myChar } or {}
	local o = cam.CFrame.Position
	local hit = Workspace:Raycast(o, pos - o, rayParams)
	return hit == nil or hit.Instance:IsDescendantOf(model)
end

-- ===== ESP OBJECTS =====
local boxes = {}
local hueMap = {}
local hueCounter = 0

local function clearAll()
	for m, o in pairs(boxes) do
		for i = 1, 8 do if o.corners[i] then o.corners[i]:Destroy() end end
		if o.label then o.label:Destroy() end
		if o.hpbg then o.hpbg:Destroy() end
		if o.tracer then o.tracer:Destroy() end
		boxes[m] = nil
		hueMap[m] = nil
	end
end

local function getESP(model)
	local o = boxes[model]
	if o then return o end
	hueCounter = (hueCounter + 0.07) % 1
	hueMap[model] = hueCounter
	local corners = makeCornerBox(gui)
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Size = UDim2.fromOffset(190, 30)
	label.Parent = gui
	local hpbg = Instance.new("Frame")
	hpbg.BackgroundColor3 = Color3.new(0, 0, 0)
	hpbg.BorderSizePixel = 0
	hpbg.Parent = gui
	local hp = Instance.new("Frame")
	hp.BackgroundColor3 = Color3.fromRGB(0, 220, 80)
	hp.BorderSizePixel = 0
	hp.AnchorPoint = Vector2.new(0, 1)
	hp.Parent = hpbg
	local tracer = Instance.new("Frame")
	tracer.AnchorPoint = Vector2.new(0.5, 0.5)
	tracer.BackgroundTransparency = 0.4
	tracer.BorderSizePixel = 0
	tracer.Visible = false
	tracer.Parent = gui
	o = { corners = corners, label = label, hpbg = hpbg, hp = hp, tracer = tracer }
	boxes[model] = o
	return o
end

local function hideESP(model)
	local o = boxes[model]
	if not o then return end
	hideCornerBox(o.corners)
	o.label.Visible = false
	o.hpbg.Visible = false
	o.tracer.Visible = false
end

-- ===== TARGETS =====
local targets = {}
local function scan()
	local list, np, nn = {}, 0, 0
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("Humanoid") and d.Health > 0 and d.Parent ~= me.Character then
			local model = d.Parent
			local plr = Players:GetPlayerFromCharacter(model)
			if plr or INCLUDE_NPCS then
				local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
					or model:FindFirstChild("UpperTorso") or model:FindFirstChildWhichIsA("BasePart")
				if root then
					list[#list + 1] = { model = model, hum = d, root = root, plr = plr }
					if plr then np += 1 else nn += 1 end
				end
			end
		end
	end
	targets = list
	local seen, nearD = 0, math.huge
	local myRoot = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
	if myRoot then
		for _, t in ipairs(list) do
			local d = (t.root.Position - myRoot.Position).Magnitude
			if d <= MAX_DISTANCE then seen += 1 if d < nearD then nearD = d end end
		end
	end
	stats.Text = string.format(" P: %d  NPC: %d  Seen: %d  Near: %ds", np, nn, seen,
		nearD < math.huge and math.floor(nearD) or 0)
	scanStatus.Text = string.format("total: %d | players: %d | npc: %d", np + nn, np, nn)
end

local running = true
task.spawn(function()
	while running do
		pcall(scan)
		task.wait(0.5)
	end
end)

-- ===== ESP STEP =====
local function espStep()
	local cam = Workspace.CurrentCamera
	local myRoot = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
	local seen = {}

	for _, t in ipairs(targets) do
		local root = t.root
		if not root.Parent or t.hum.Health <= 0 then
			hideESP(t.model)
		else
			local pos = root.Position
			local dist = (pos - (myRoot and myRoot.Position or cam.CFrame.Position)).Magnitude
			local top = cam:WorldToViewportPoint(pos + Vector3.new(0, 3, 0))
			local bot = cam:WorldToViewportPoint(pos - Vector3.new(0, 3.2, 0))
			if dist > MAX_DISTANCE or top.Z <= 0 or bot.Z <= 0 then
				hideESP(t.model)
			else
				seen[t.model] = true
				local o = getESP(t.model)
				local col
				if RAINBOW then
					col = rainbowColor(hueMap[t.model] or 0)
				elseif t.plr == nil then
					col = NPC_COLOR
				elseif TEAM_CHECK and t.plr.Team ~= nil and t.plr.Team == me.Team and #game:GetService("Teams"):GetChildren() > 1 then
					col = TEAM_COLOR
				else
					col = isVisible(cam, pos, t.model) and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(255, 60, 60)
				end

				local h = math.max(math.abs(bot.Y - top.Y), 8)
				local w = h * 0.55
				local sx, sy = top.X - w / 2, top.Y

				updateCornerBox(o.corners, sx, sy, w, h, col, 2)
				showCornerBox(o.corners)

				if subState.name then
					o.label.Text = t.model.Name .. " " .. math.floor(dist) .. "m"
					o.label.TextColor3 = col
					o.label.Position = UDim2.fromOffset(top.X, sy - 2)
					o.label.Visible = true
				else
					o.label.Visible = false
				end

				if subState.health then
					local frac = math.clamp(t.hum.Health / math.max(t.hum.MaxHealth, 1), 0, 1)
					o.hpbg.Position = UDim2.fromOffset(sx - 5, sy)
					o.hpbg.Size = UDim2.fromOffset(3, h)
					o.hpbg.Visible = true
					o.hp.Size = UDim2.new(1, 0, frac, 0)
					o.hp.Position = UDim2.new(0, 0, 1 - frac, 0)
					o.hp.BackgroundColor3 = Color3.fromRGB(math.floor((1 - frac) * 255), math.floor(frac * 200), 50)
				else
					o.hpbg.Visible = false
				end

				if subState.tracer then
					updateTracer(o.tracer, top.X, sy, col)
				else
					o.tracer.Visible = false
				end
			end
		end
	end

	for m in pairs(boxes) do
		if not seen[m] then hideESP(m) end
	end
end

RunService:BindToRenderStep("AmerESP", Enum.RenderPriority.Camera.Value + 2, function()
	if espOn then pcall(espStep) end
end)

