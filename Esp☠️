	playClick()
	espOn = not espOn
	espBtn.Text = "ESP: " .. (espOn and "ON" or "OFF")
	espBtn.BackgroundColor3 = espOn and ON_COLOR or OFF_COLOR
	espBtnStroke.Color = espOn and rainbowColor(0.3) or Color3.fromRGB(255, 60, 60)
	if not espOn then clearAll() end
end
track(espBtn.Activated:Connect(toggleESP))
track(UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.F1 then toggleESP() end
end))

